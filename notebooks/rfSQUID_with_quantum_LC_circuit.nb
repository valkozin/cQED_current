Cell[CellGroupData[{

Cell[TextData[{
 "Important note: here phases (by construction are measured in unites of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalPhi]", "SC"], "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e16139f8-da1f-4cf1-a486-1f3c2c5af224"],
 "! That\[CloseCurlyQuote]s why 2\[Pi] periodicity here means \
\[Pi]-periodicity in terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalPhi]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d248f938-6226-4a89-bd80-a379afb0a17e"]
}], "Subtitle",
 CellChangeTimes->{{3.971859857450286*^9, 
  3.9718599338925037`*^9}},ExpressionUUID->"8a156f54-a0e3-4030-a9d7-\
c0a8589f83a8"],

Cell["\<\
for 0-junction we get the following dependence of the GS energy on  the \
external flux (no cavity):\
\>", "Subtitle",
 CellChangeTimes->{{3.971860193013867*^9, 3.971860201007571*^9}, {
  3.97186445283361*^9, 3.971864489719392*^9}, {3.971864553425428*^9, 
  3.971864556227339*^9}},ExpressionUUID->"2abae5a0-5db2-4311-a649-\
3522ae485e19"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EC", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EL", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EJ", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffECoverEL", "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["EC", "EL"], ")"}], 
     RowBox[{"1", "/", "4"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"energiesArray", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Hrf", "=", 
       RowBox[{
        RowBox[{"EC", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", 
            FractionBox["1", 
             SqrtBox["2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["EL", "EC"], ")"}], 
             RowBox[{"1", "/", "4"}]], 
            RowBox[{"(", 
             RowBox[{"b\[Dagger]", "-", "b"}], ")"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", 
            FractionBox["1", 
             SqrtBox["2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["EL", "EC"], ")"}], 
             RowBox[{"1", "/", "4"}]], 
            RowBox[{"(", 
             RowBox[{"b\[Dagger]", "-", "b"}], ")"}]}], ")"}]}]}], "+", 
        RowBox[{"EL", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["EC", "EL"], ")"}], 
              RowBox[{"1", "/", "4"}]], 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], "-", 
            RowBox[{"\[Phi]ext", " ", "identityOp"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["EC", "EL"], ")"}], 
              RowBox[{"1", "/", "4"}]], 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], "-", 
            RowBox[{"\[Phi]ext", " ", "identityOp"}]}], ")"}]}]}], "-", 
        RowBox[{"EJ", " ", 
         RowBox[{"MatrixFunction", "[", 
          RowBox[{"Cos", ",", 
           RowBox[{"(", " ", 
            RowBox[{"coeffECoverEL", 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], ")"}]}], "]"}]}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"GS", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{
          RowBox[{"-", "Hrf"}], ",", "1", ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Arnoldi\>\"", ",", 
             RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}]}], 
            "}"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"GS", "=", 
       RowBox[{"GS", "/", 
        SqrtBox[
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "GS", "]"}], ".", "GS"}]]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"GS\[Dagger]", "=", 
       RowBox[{"ConjugateTranspose", "[", "GS", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[Phi]ext", ",", 
        RowBox[{"GS\[Dagger]", ".", "Hrf", ".", "GS"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Phi]ext", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}], ",", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "[", "energiesArray", "]"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"MaTeX", "@", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\\\\phi_\\\\text{ext}/(\\\\Phi_0^\\\\text{SC}/(2\\\\pi))\>\"", 
       ",", "\"\<E_\\\\text{GS}\>\""}], "}"}]}]}], ",", 
   RowBox[{"Joined", "->", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.971852843404068*^9, {3.97185966203788*^9, 3.9718597785963497`*^9}, {
   3.971859816535684*^9, 3.971859825447442*^9}, {3.9718599438870296`*^9, 
   3.9718599439986773`*^9}, {3.971859981203042*^9, 3.971860001677333*^9}, {
   3.971860152530216*^9, 3.971860177256991*^9}, {3.9718636371323853`*^9, 
   3.971863694251667*^9}, {3.971863783398098*^9, 3.971863787684064*^9}, {
   3.971864256821746*^9, 3.9718642768701477`*^9}, 3.971864334678899*^9, 
   3.971864609056826*^9, {3.9718839222866745`*^9, 3.971883922800396*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"b861601e-f554-4be6-9a15-50e0b4251abf"],

