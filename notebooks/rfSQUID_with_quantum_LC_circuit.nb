Cell[CellGroupData[{

Cell[TextData[StyleBox["for \[Pi]- junction we get the following dependence \
of the GS energy on  the external flux (no cavity)", "Subtitle"]], "Chapter",
 CellChangeTimes->{{3.9718602050807743`*^9, 3.971860214615933*^9}, {
   3.971864442034699*^9, 3.971864445514124*^9}, 
   3.971864568105404*^9},ExpressionUUID->"6f743a0a-d658-44ae-8d85-\
dbeeb076749d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EC", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EL", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EJ", "=", 
   RowBox[{"-", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffECoverEL", "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["EC", "EL"], ")"}], 
     RowBox[{"1", "/", "4"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"energiesArray", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Hrf", "=", 
       RowBox[{
        RowBox[{"EC", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", 
            FractionBox["1", 
             SqrtBox["2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["EL", "EC"], ")"}], 
             RowBox[{"1", "/", "4"}]], 
            RowBox[{"(", 
             RowBox[{"b\[Dagger]", "-", "b"}], ")"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{"\[ImaginaryI]", 
            FractionBox["1", 
             SqrtBox["2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox["EL", "EC"], ")"}], 
             RowBox[{"1", "/", "4"}]], 
            RowBox[{"(", 
             RowBox[{"b\[Dagger]", "-", "b"}], ")"}]}], ")"}]}]}], "+", 
        RowBox[{"EL", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["EC", "EL"], ")"}], 
              RowBox[{"1", "/", "4"}]], 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], "-", 
            RowBox[{"\[Phi]ext", " ", "identityOp"}]}], ")"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             FractionBox["1", 
              SqrtBox["2"]], 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox["EC", "EL"], ")"}], 
              RowBox[{"1", "/", "4"}]], 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], "-", 
            RowBox[{"\[Phi]ext", " ", "identityOp"}]}], ")"}]}]}], "-", 
        RowBox[{"EJ", " ", 
         RowBox[{"MatrixFunction", "[", 
          RowBox[{"Cos", ",", 
           RowBox[{"(", " ", 
            RowBox[{"coeffECoverEL", 
             RowBox[{"(", 
              RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], ")"}]}], "]"}]}]}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"GS", "=", 
       RowBox[{
        RowBox[{"Eigenvectors", "[", 
         RowBox[{
          RowBox[{"-", "Hrf"}], ",", "1", ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<Arnoldi\>\"", ",", 
             RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}]}], 
            "}"}]}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"GS", "=", 
       RowBox[{"GS", "/", 
        SqrtBox[
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "GS", "]"}], ".", "GS"}]]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"GS\[Dagger]", "=", 
       RowBox[{"ConjugateTranspose", "[", "GS", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[Phi]ext", ",", 
        RowBox[{"GS\[Dagger]", ".", "Hrf", ".", "GS"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Phi]ext", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}], ",", "0.05"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "[", "energiesArray", "]"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"MaTeX", "@", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\\\\phi_\\\\text{ext}/(\\\\Phi_0^\\\\text{SC}/(2\\\\pi))\>\"", 
       ",", "\"\<E_\\\\text{GS}\>\""}], "}"}]}]}], ",", 
   RowBox[{"Joined", "->", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.971860185829781*^9, 3.9718643758957453`*^9, 3.971864581380735*^9, 
   3.9718646123302307`*^9, {3.97186469247567*^9, 3.971864704025275*^9}, {
   3.9718839289257355`*^9, 3.971883929086115*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"75610662-e3a5-48e9-a9ed-957b7ad999e1"],

