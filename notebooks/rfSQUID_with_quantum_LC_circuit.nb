  "],ExpressionUUID->"601a2aeb-46a7-9a4b-8c05-db97d53078aa"],

Cell[CellGroupData[{

Cell[TextData[{
 "for 0-junction (at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "ext"], "=", 
    RowBox[{"\[Pi]", " ", "-", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], TraditionalForm]],ExpressionUUID->
  "e1f2ec97-2241-4429-aafc-bd2b031019cd"],
 ") we get (at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "ext"], "=", 
    RowBox[{"\[Pi]", " ", "+", 
     SuperscriptBox["10", 
      RowBox[{"-", "3"}]]}]}], TraditionalForm]],ExpressionUUID->
  "04b64c76-e376-46b3-bd4e-e4e7f3b8f347"],
 " the flux and the current would have the opposite sign -- instability):"
}], "Subtitle",
 CellChangeTimes->{{3.971860429855927*^9, 3.971860466079324*^9}, {
  3.97186055371907*^9, 
  3.971860600204657*^9}},ExpressionUUID->"78849e4f-b878-4fc6-86ed-\
ea3867ee34d8"],

Cell["\<\
uncomment printing plots to track the convergence of the self-consistent loop\
\>", "Subtitle",
 CellChangeTimes->{{3.9718630962227497`*^9, 
  3.9718631113575172`*^9}},ExpressionUUID->"a45891fc-3922-4983-8520-\
d529c00af136"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NumStepsForConvergence", "=", "50"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EC", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EL", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EJ", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coeffECoverEL", "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox["2"]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["EC", "EL"], ")"}], 
     RowBox[{"1", "/", "4"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Phi]ext", "=", 
   RowBox[{"\[Pi]", "-", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HrfMF0", "=", 
   RowBox[{
    RowBox[{"2", 
     SqrtBox[
      RowBox[{"EC", " ", "EL"}]], "bNumOp"}], "-", 
    RowBox[{"2", "EL", " ", "\[Phi]ext", 
     FractionBox["1", 
      SqrtBox["2"]], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["EC", "EL"], ")"}], 
      RowBox[{"1", "/", "4"}]], 
     RowBox[{"(", 
      RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], "-", 
    RowBox[{"EJ", " ", 
     RowBox[{"MatrixFunction", "[", 
      RowBox[{"Cos", ",", 
       RowBox[{"(", " ", 
        RowBox[{"coeffECoverEL", 
         RowBox[{"(", 
          RowBox[{"b", "+", "b\[Dagger]"}], ")"}]}], ")"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GS0", "=", 
   RowBox[{
    RowBox[{"Eigenvectors", "[", 
     RowBox[{
      RowBox[{"-", "HrfMF0"}], ",", "1", ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Arnoldi\>\"", ",", 
         RowBox[{"\"\<Criteria\>\"", "->", "\"\<RealPart\>\""}]}], "}"}]}]}], 
     "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GS0", "=", 
   RowBox[{"GS0", "/", 
    SqrtBox[
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "GS0", "]"}], ".", "GS0"}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GS0\[Dagger]", "=", 
   RowBox[{"ConjugateTranspose", "[", "GS0", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1min", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g1max", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dg1", "=", "0.025"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"currents", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g1min", ",", "g1max", ",", "dg1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"energies", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g1min", ",", "g1max", ",", "dg1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fluxes", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"g1", ",", "g1min", ",", "g1max", ",", "dg1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bCommutatorArray", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
