Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", "energies"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Extract", " ", "x", " ", "and", " ", "y", " ", "values"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "=", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "First"}]}], " ", "derivative", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"central", " ", "difference"}], ")"}], "--"}]}], "-"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"firstDeriv", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
           RowBox[{"y", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", 
        RowBox[{
         RowBox[{"Length", "[", "data", "]"}], "-", "1"}]}], "}"}]}], "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "approximate", " ", "second", " ", "derivative", " ", 
    "using", " ", "finite", " ", "differences"}], "*)"}], 
  RowBox[{
   RowBox[{"secondDeriv", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
           RowBox[{"2", " ", 
            RowBox[{"y", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "+", 
           RowBox[{"y", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
             RowBox[{"x", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"x", "[", 
              RowBox[{"[", 
               RowBox[{"i", "-", "1"}], "]"}], "]"}]}], ")"}]}], ")"}]}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", 
        RowBox[{
         RowBox[{"Length", "[", "data", "]"}], "-", "1"}]}], "}"}]}], "]"}]}],
    ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Original", " ", "data"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"data", ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Energies\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"MaTeX", "@", 
       RowBox[{"{", 
        RowBox[{"\"\<g_1\>\"", ",", "\"\<E_\\\\text{GS}\>\""}], "}"}]}]}]}], 
    "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "derivative"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"firstDeriv", ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Orange"}], "}"}]}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<First Derivative\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"MaTeX", "@", 
       RowBox[{"{", 
        RowBox[{
        "\"\<g_1\>\"", ",", 
         "\"\<\\\\partial E_\\\\text{GS}/\\\\partial g_1\>\""}], "}"}]}]}]}], 
    "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Second", " ", "derivative"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"secondDeriv", ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Second Derivative\>\""}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"MaTeX", "@", 
       RowBox[{"{", 
        RowBox[{
        "\"\<g_1\>\"", ",", 
         "\"\<\\\\partial^2 E_\\\\text{GS}/\\\\partial g_1^2\>\""}], 
        "}"}]}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "\n"}], "\n"}], "Input",
