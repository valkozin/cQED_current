Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NbosTrunc", "=", "200"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "truncation", " ", "of", " ", "the", " ", "bosonic", " ", "Hilbert", " ", 
     "space"}], ";"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"j", "==", 
         RowBox[{"i", "+", "1"}]}], ",", 
        RowBox[{
         SqrtBox["i"], "//", "N"}], ",", "0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "NbosTrunc"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "NbosTrunc"}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "bosonic", " ", "annihilation", " ", "op", " ", "acting", " ", "in", " ", 
    "the", " ", "photonic", " ", "Hilbert", " ", "space"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b\[Dagger]", "=", 
    RowBox[{"Transpose", "[", "b", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "bosonic", " ", "creation", " ", "op", " ", "acting", " ", "in", " ", 
    "the", " ", "photonic", " ", "Hilbert", " ", "space"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bNumOp", "=", 
   RowBox[{"b\[Dagger]", ".", "b"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"identityOp", "=", 
   RowBox[{"IdentityMatrix", "[", "NbosTrunc", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bCommutator", "=", 
   RowBox[{
    RowBox[{"b", ".", "b\[Dagger]"}], "-", 
    RowBox[{"b\[Dagger]", ".", "b"}]}]}], ";"}]}], "Input",
 CellChangeTimes->CompressedData["
